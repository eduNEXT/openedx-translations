msgstr[1] "ma ci sono solo problemi di corrispondenza {actual} ."
msgstr[2] "ma ci sono solo problemi di corrispondenza {actual} ."

#: xmodule/library_content_block.py:721
msgid "Edit the library configuration."
msgstr "Modifica la configurazione della libreria."

#: xmodule/library_content_block.py:739
msgid "Invalid Library"
msgstr "Libreria non valida"

#: xmodule/library_content_block.py:740
msgid "No Library Selected"
msgstr "Nessuna libreria selezionata"

#: xmodule/library_root_xblock.py:32
msgid "Library Display Name"
msgstr "Nome visualizzato della libreria"

#: xmodule/library_root_xblock.py:37
msgid "Enter the names of the advanced components to use in your library."
msgstr ""
"Inserisci i nomi dei componenti avanzati da utilizzare nella tua libreria."

#: xmodule/lti_block.py:133
msgid ""
"The display name for this component. Analytics reports may also use the "
"display name to identify this component."
msgstr ""
"Il nome visualizzato per questo componente. I report di Analytics possono "
"anche utilizzare il nome visualizzato per identificare questo componente."

#: xmodule/lti_block.py:140
msgid "LTI ID"
msgstr "LTI ID"

#: xmodule/lti_block.py:142
#, python-brace-format
msgid ""
"Enter the LTI ID for the external LTI provider.  This value must be the same"
" LTI ID that you entered in the LTI Passports setting on the Advanced "
"Settings page.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Inserisci l&#39;ID LTI per il fornitore LTI esterno. Questo valore deve "
"essere lo stesso ID LTI immesso nell&#39;impostazione Passaporti LTI nella "
"pagina Impostazioni avanzate. {break_tag} Consulta {docs_anchor_open} la "
"documentazione edX LTI {anchor_close} per maggiori dettagli su questa "
"impostazione."

#: xmodule/lti_block.py:155
msgid "LTI URL"
msgstr "LTI URL"

#: xmodule/lti_block.py:157
#, python-brace-format
msgid ""
"Enter the URL of the external tool that this component launches. This "
"setting is only used when Hide External Tool is set to False.{break_tag}See "
"{docs_anchor_open}the edX LTI documentation{anchor_close} for more details "
"on this setting."
msgstr ""
"Inserisci l&#39;URL dello strumento esterno avviato da questo componente. "
"Questa impostazione viene utilizzata solo quando Nascondi strumento esterno "
"è impostato su False. {break_tag} Consulta {docs_anchor_open} la "
"documentazione edX LTI {anchor_close} per maggiori dettagli su questa "
"impostazione."

#: xmodule/lti_block.py:168
msgid "Custom Parameters"
msgstr "Parametri personalizzati"

#: xmodule/lti_block.py:170
#, python-brace-format
msgid ""
"Add the key/value pair for any custom parameters, such as the page your "
"e-book should open to or the background color for this "
"component.{break_tag}See {docs_anchor_open}the edX LTI "
"documentation{anchor_close} for more details on this setting."
msgstr ""
"Aggiungi la coppia chiave/valore per eventuali parametri personalizzati, "
"come la pagina in cui dovrebbe aprirsi il tuo e-book o il colore di sfondo "
"per questo componente. {break_tag} Consulta {docs_anchor_open} la "
"documentazione edX LTI {anchor_close} per maggiori dettagli su questa "
"impostazione."

#: xmodule/lti_block.py:180
msgid "Open in New Page"
msgstr "Apri in una nuova pagina"

#: xmodule/lti_block.py:182
msgid ""
"Select True if you want students to click a link that opens the LTI tool in "
"a new window. Select False if you want the LTI content to open in an IFrame "
"in the current page. This setting is only used when Hide External Tool is "
"set to False.  "
msgstr ""
"Seleziona Vero se desideri che gli studenti facciano clic su un collegamento"
" che apre lo strumento LTI in una nuova finestra. Seleziona False se "
"desideri che il contenuto LTI si apra in un IFrame nella pagina corrente. "
"Questa impostazione viene utilizzata solo quando Nascondi strumento esterno "
"è impostato su False.  "

#: xmodule/lti_block.py:190
msgid "Scored"
msgstr "Con punteggio"

#: xmodule/lti_block.py:192
msgid ""
"Select True if this component will receive a numerical score from the "
"external LTI system."
msgstr ""
"Selezionare True se questo componente riceverà un punteggio numerico dal "
"sistema LTI esterno."

#: xmodule/lti_block.py:198
msgid "Weight"
msgstr "Peso"

#: xmodule/lti_block.py:200
msgid ""
"Enter the number of points possible for this component.  The default value "
"is 1.0.  This setting is only used when Scored is set to True."
msgstr ""
"Immettere il numero di punti possibili per questo componente.  Il valore "
"predefinito è 1.0.  Questa impostazione è utilizzata solo quando l'opzione "
"Con punteggio è impostata su True. "

#: xmodule/lti_block.py:209
msgid ""
"The score kept in the xblock KVS -- duplicate of the published score in "
"django DB"
msgstr ""
"Il punteggio conservato in xblock KVS -- duplicato del punteggio pubblicato "
"nel DB django"

#: xmodule/lti_block.py:214
msgid "Comment as returned from grader, LTI2.0 spec"
msgstr "Commento come restituito dall'esaminatore, LTI2.0 spec"

#: xmodule/lti_block.py:219
msgid "Hide External Tool"
msgstr "Nasconti Strumento Esterno"

#: xmodule/lti_block.py:221
msgid ""
"Select True if you want to use this component as a placeholder for syncing "
"with an external grading  system rather than launch an external tool.  This "
"setting hides the Launch button and any IFrames for this component."
msgstr ""
"Selezionare True se si desidera utilizzare questo componente come segnaposto"
" per la sincronizzazione con un sistema di valutazione esterno anziché "
"avviare uno strumento esterno.  Questa impostazione nasconde il pulsante di "
"avvio e tutti gli IFrames per questo componente."

#: xmodule/lti_block.py:232
msgid "Request user's username"
msgstr "Richiedi il nome utente dell'utente"

#. Translators: This is used to request the user's username for a third party
#. service.
#: xmodule/lti_block.py:234
msgid "Select True to request the user's username."
msgstr "Seleziona True per richiedere il nome utente dell'utente"

#: xmodule/lti_block.py:239
msgid "Request user's email"
msgstr "Richiedi l'indirizzo email dell'utente"

#. Translators: This is used to request the user's email for a third party
#. service.
#: xmodule/lti_block.py:241
msgid "Select True to request the user's email address."
msgstr "Seleziona True per richiedere l'indirizzo email dell'utente"

#: xmodule/lti_block.py:247
msgid "LTI Application Information"
msgstr "Informazioni sull'applicazione LTI"

#: xmodule/lti_block.py:249
msgid ""
"Enter a description of the third party application. If requesting username "
"and/or email, use this text box to inform users why their username and/or "
"email will be forwarded to a third party application."
msgstr ""
"Immettere una descrizione dell'applicazione di terze parti. Se si richiede "
"il nome utente e/o l'email, utilizzare questa casella di testo per informare"
" gli utenti del motivo per cui il loro nome utente e/o email verranno "
"forniti ad un'applicazione di terze parti."

#: xmodule/lti_block.py:257
msgid "Button Text"
msgstr "Testo del bottone"

#: xmodule/lti_block.py:259
msgid ""
"Enter the text on the button used to launch the third party application."
msgstr ""
"Immettere il testo sul pulsante utilizzato per avviare l&#39;applicazione di"
" terze parti."

#: xmodule/lti_block.py:266
msgid "Accept grades past deadline"
msgstr "Accetta valutazioni dopo la data di scadenza"

#: xmodule/lti_block.py:267
msgid ""
"Select True to allow third party systems to post grades past the deadline."
msgstr ""
"Selezionare True per consentire ai sistemi di terze parti di postare le "
"valutazioni dopo la scadenza."

#: xmodule/lti_block.py:440
#, python-brace-format
msgid ""
"Could not parse custom parameter: {custom_parameter}. Should be \"x=y\" "
"string."
msgstr ""
"Impossibile analizzare il parametro personalizzato: {custom_parameter} . "
"Dovrebbe essere la stringa &quot;x=y&quot;."

#: xmodule/lti_block.py:942
#, python-brace-format
msgid ""
"Could not parse LTI passport: {lti_passport}. Should be \"id:key:secret\" "
"string."
msgstr ""
"Impossibile analizzare il passaporto LTI: {lti_passport} . Dovrebbe essere "
"la stringa &quot;id:key:secret&quot;."

#: xmodule/modulestore/inheritance.py:47 xmodule/seq_block.py:82
#: lms/templates/ccx/schedule.html:115
msgid "Due Date"
msgstr "Data di consegna"

#: xmodule/modulestore/inheritance.py:48
msgid "Enter the default date by which problems are due."
msgstr ""
"Immettere la data predefinita entro la quale i problemi devono essere "
"risolti."

#: xmodule/modulestore/inheritance.py:53 xmodule/seq_block.py:88
msgid "Number of Relative Weeks Due By"
msgstr "Numero di settimane relative dovute a"

#: xmodule/modulestore/inheritance.py:54 xmodule/seq_block.py:89
msgid ""
"Enter the number of weeks the problems are due by relative to the learner's "
"enrollment date"
msgstr ""
"Inserisci il numero di settimane entro le quali i problemi sono dovuti alla "
"data di iscrizione dello studente"

#: xmodule/modulestore/inheritance.py:70
msgid "GIT URL"
msgstr "URL GIT"

#: xmodule/modulestore/inheritance.py:71
msgid "Enter the URL for the course data GIT repository."
msgstr "Inserisci l&#39;URL del repository GIT dei dati del corso."

#: xmodule/modulestore/inheritance.py:75
msgid "XQA Key"
msgstr "Chiave XQA"

#: xmodule/modulestore/inheritance.py:76
msgid "This setting is not currently supported."
msgstr "Questa impostazione non è attualmente supportata."

#: xmodule/modulestore/inheritance.py:84
msgid "Enter the ids for the content groups this problem belongs to."
msgstr ""
"Inserisci gli ID dei gruppi di contenuti a cui appartiene questo problema."

#. Translators: DO NOT translate the words in quotes here, they are
#. specific words for the acceptable values.
#: xmodule/modulestore/inheritance.py:93
msgid ""
"Specify when the Show Answer button appears for each problem. Valid values "
"are \"always\", \"answered\", \"attempted\", \"closed\", \"finished\", "
"\"past_due\", \"correct_or_past_due\", \"after_all_attempts\", "
"\"after_all_attempts_or_correct\", \"attempted_no_past_due\", and \"never\"."
msgstr ""
"Specificare quando viene visualizzato il pulsante Mostra risposta per "
"ciascun problema. I valori validi sono &quot;always&quot;, "
"&quot;answered&quot;, &quot;attempted&quot;, &quot;closed&quot;, "
"&quot;finished&quot;, &quot;past_due&quot;, &quot;correct_or_past_due&quot;,"
" &quot;after_all_attempts&quot;, &quot;after_all_attempts_or_correct&quot;, "
"&quot;attempted_no_past_due&quot; e &quot;never&quot;."

#. Translators: DO NOT translate the words in quotes here, they are
#. specific words for the acceptable values.
#: xmodule/modulestore/inheritance.py:107
msgid ""
"Specify when to show answer correctness and score to learners. Valid values "
"are \"always\", \"never\", and \"past_due\"."
msgstr ""
"Specificare quando mostrare agli studenti la correttezza delle risposte e il"
" punteggio. I valori validi sono &quot;sempre&quot;, &quot;mai&quot; e "
"&quot;past_due&quot;."

#. Translators: DO NOT translate the words in quotes here, they are
#. specific words for the acceptable values.
#: xmodule/modulestore/inheritance.py:119
msgid ""
"Specify the default for how often variable values in a problem are "
"randomized. This setting should be set to \"never\" unless you plan to "
"provide a Python script to identify and randomize values in most of the "
"problems in your course. Valid values are \"always\", \"onreset\", "
"\"never\", and \"per_student\"."
msgstr ""
"Specificare il valore predefinito per la frequenza con cui i valori delle "
"variabili in un problema vengono randomizzati. Questa impostazione dovrebbe "
"essere impostata su &quot;mai&quot; a meno che tu non preveda di fornire uno"
" script Python per identificare e randomizzare i valori nella maggior parte "
"dei problemi del tuo corso. I valori validi sono &quot;sempre&quot;, "
"&quot;onreset&quot;, &quot;never&quot; e &quot;per_student&quot;."

#: xmodule/modulestore/inheritance.py:128
msgid "Days Early for Beta Users"
msgstr "Giorni in anticipo per gli utenti Beta"

#: xmodule/modulestore/inheritance.py:129
msgid ""
"Enter the number of days before the start date that beta users can access "
"the course."
msgstr ""
"Inserisci il numero di giorni prima della data di inizio durante i quali gli"
" utenti beta possono accedere al corso."

#: xmodule/modulestore/inheritance.py:134
msgid "Static Asset Path"
msgstr "Percorso risorsa statica"

#: xmodule/modulestore/inheritance.py:135
msgid ""
"Enter the path to use for files on the Files & Uploads page. This value "
"overrides the Studio default, c4x://."
msgstr ""
"Inserisci il percorso da utilizzare per i file nella pagina File e "
"caricamenti. Questo valore sostituisce quello predefinito di Studio, c4x://."

#: xmodule/modulestore/inheritance.py:140
msgid "Enable LaTeX Compiler"
msgstr "Abilita il compilatore LaTeX"

#: xmodule/modulestore/inheritance.py:141
msgid ""
"Enter true or false. If true, you can use the LaTeX templates for HTML "
"components and advanced Problem components."
msgstr ""
"Inserisci vero o falso. Se è vero, puoi utilizzare i modelli LaTeX per i "
"componenti HTML e i componenti avanzati dei problemi."

#: xmodule/modulestore/inheritance.py:147
msgid ""
"Enter the maximum number of times a student can try to answer problems. By "
"default, Maximum Attempts is set to null, meaning that students have an "
"unlimited number of attempts for problems. You can override this course-wide"
" setting for individual problems. However, if the course-wide setting is a "
"specific number, you cannot set the Maximum Attempts for individual problems"
" to unlimited."
msgstr ""
"Inserisci il numero massimo di volte in cui uno studente può provare a "
"rispondere ai problemi. Per impostazione predefinita, Numero massimo di "
"tentativi è impostato su null, il che significa che gli studenti hanno a "
"disposizione un numero illimitato di tentativi per risolvere i problemi. "
"Puoi ignorare questa impostazione a livello di corso per singoli problemi. "
"Tuttavia, se l&#39;impostazione dell&#39;intero corso corrisponde a un "
"numero specifico, non è possibile impostare il numero massimo di tentativi "
"per i singoli problemi su un numero illimitato."

#: xmodule/modulestore/inheritance.py:152
msgid ""
"Enter the API key provided by MathWorks for accessing the MATLAB Hosted "
"Service. This key is granted for exclusive use in this course for the "
"specified duration. Do not share the API key with other courses. Notify "
"MathWorks immediately if you believe the key is exposed or compromised. To "
"obtain a key for your course, or to report an issue, please contact "
"moocsupport@mathworks.com"
msgstr ""
"Inserisci la chiave API fornita da MathWorks per accedere al servizio "
"ospitato MATLAB. Questa chiave viene concessa per l&#39;uso esclusivo in "
"questo corso per la durata specificata. Non condividere la chiave API con "
"altri corsi. Avvisa immediatamente MathWorks se ritieni che la chiave sia "
"esposta o compromessa. Per ottenere una chiave per il tuo corso o per "
"segnalare un problema, contatta moocsupport@mathworks.com"

#: xmodule/modulestore/inheritance.py:162 cms/templates/certificates.html:119
#: cms/templates/group_configurations.html:17
#: cms/templates/group_configurations.html:46 cms/templates/settings.html:723
#: cms/templates/settings_advanced.html:149
#: cms/templates/settings_graders.html:170
#: cms/templates/widgets/header.html:193
msgid "Group Configurations"
msgstr "Configurazioni del gruppo"

#: xmodule/modulestore/inheritance.py:163
msgid ""
"Enter the configurations that govern how students are grouped together."
msgstr ""
"Inserisci le configurazioni che regolano il modo in cui gli studenti vengono"
" raggruppati."

#: xmodule/modulestore/inheritance.py:168
msgid "Enable video caching system"
msgstr "Abilita il sistema di memorizzazione nella cache video"

#: xmodule/modulestore/inheritance.py:169
msgid ""
"Enter true or false. If true, video caching will be used for HTML5 videos."
msgstr ""
"Inserisci vero o falso. Se vero, la memorizzazione nella cache video verrà "
"utilizzata per i video HTML5."

#: xmodule/modulestore/inheritance.py:174
msgid "Enable video auto-advance"
msgstr "Abilita l&#39;avanzamento automatico del video"

#: xmodule/modulestore/inheritance.py:176
msgid ""
"Specify whether to show an auto-advance button in videos. If the student "
"clicks it, when the last video in a unit finishes it will automatically move"
" to the next unit and autoplay the first video."
msgstr ""
"Specifica se mostrare un pulsante di avanzamento automatico nei video. Se lo"
" studente fa clic su di esso, al termine dell&#39;ultimo video di "
"un&#39;unità si passerà automaticamente all&#39;unità successiva e verrà "
"riprodotto automaticamente il primo video."

#: xmodule/modulestore/inheritance.py:182
msgid "Video Pre-Roll"
msgstr "Pre-roll video"

#: xmodule/modulestore/inheritance.py:184
#, python-brace-format
msgid ""
"Identify a video, 5-10 seconds in length, to play before course videos. "
"Enter the video ID from the Video Uploads page and one or more transcript "
"files in the following format: {format}. For example, an entry for a video "
"with two transcripts looks like this: {example}"
msgstr ""
"Individua un video, della durata di 5-10 secondi, da riprodurre prima dei "
"video del corso. Inserisci l&#39;ID video dalla pagina Caricamenti video e "
"uno o più file di trascrizione nel seguente formato: {format} . Ad esempio, "
"una voce per un video con due trascrizioni assomiglia a questa: {example}"

#: xmodule/modulestore/inheritance.py:201
msgid "Show Reset Button for Problems"
msgstr "Mostra il pulsante di ripristino in caso di problemi"

#: xmodule/modulestore/inheritance.py:203
msgid ""
"Enter true or false. If true, problems in the course default to always "
"displaying a 'Reset' button. You can override this in each problem's "
"settings. All existing problems are affected when this course-wide setting "
"is changed."
msgstr ""
"Inserisci vero o falso. Se è vero, per impostazione predefinita i problemi "
"nel corso visualizzano sempre un pulsante &quot;Ripristina&quot;. Puoi "
"sovrascriverlo nelle impostazioni di ogni problema. Tutti i problemi "
"esistenti vengono influenzati quando questa impostazione a livello di corso "
"viene modificata."

#: xmodule/modulestore/inheritance.py:211
msgid "Enable Student Notes"
msgstr "Abilita le note degli studenti"

#: xmodule/modulestore/inheritance.py:212
msgid ""
"Enter true or false. If true, students can use the Student Notes feature."
msgstr ""
"Inserisci vero o falso. Se vero, gli studenti possono utilizzare la funzione"
" Note dello studente."

#: xmodule/modulestore/inheritance.py:218
msgid ""
"Indicates whether Student Notes are visible in the course. Students can also"
" show or hide their notes in the courseware."
msgstr ""
"Indica se le note dello studente sono visibili nel corso. Gli studenti "
"possono anche mostrare o nascondere i propri appunti nel materiale "
"didattico."

#: xmodule/modulestore/inheritance.py:225
msgid "Tag this block as part of an Entrance Exam section"
msgstr ""
"Contrassegna questo blocco come parte di una sezione dell&#39;esame di "
"ammissione"

#: xmodule/modulestore/inheritance.py:226
msgid ""
"Enter true or false. If true, answer submissions for problem blocks will be "
"considered in the Entrance Exam scoring/gating algorithm."
msgstr ""
"Inserisci vero o falso. Se vero, le risposte inviate per i blocchi "
"problematici verranno prese in considerazione nell&#39;algoritmo di "
"punteggio/gating dell&#39;esame di ammissione."

#: xmodule/modulestore/inheritance.py:244
msgid "Hide from Table of Contents"
msgstr "Nascondi dal sommario"

#: xmodule/modulestore/inheritance.py:245
msgid ""
"Enter true or false. If true, this block will be hidden from the Table of "
"Contents."
msgstr ""
"Inserisci vero o falso. Se vero, questo blocco verrà nascosto dal sommario."

