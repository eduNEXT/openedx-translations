msgstr "Antwort-ID"

#: xmodule/capa_block.py:777 xmodule/capa_block.py:793
msgid "Question"
msgstr "Frage"

#: xmodule/capa_block.py:781
msgid "Correct Answer"
msgstr "Korrekte Antwort"

#: xmodule/capa_block.py:1014
msgid "Submitting"
msgstr "Übermitteln, einreichen"

#: xmodule/capa_block.py:1144
