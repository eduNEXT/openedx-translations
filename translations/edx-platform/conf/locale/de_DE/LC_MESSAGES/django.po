#, python-brace-format
msgid "Hint ({hint_num} of {hints_count}): "
msgstr "Hinweis ( {hint_num} von {hints_count} ): "

#: xmodule/capa_block.py:1295
#, python-brace-format
msgid ""
"Your answers were previously saved. Click '{button_name}' to grade them."
msgstr ""
"Ihre Antworten wurden zuvor gespeichert. Klicken Sie auf „{button_name}“, um"
" sie zu bewerten."

#: xmodule/capa_block.py:1370
#, python-brace-format
